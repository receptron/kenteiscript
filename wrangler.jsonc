{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mulmo-kentei",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Bundles quizzes/*.json into the Worker, and writes the page's copy of the game rules
  // (public/game.js from src/game.ts), before every `wrangler dev` / `wrangler deploy`.
  "build": { "command": "node scripts/gen-quizzes.mjs && node scripts/gen-game.mjs", "watch_dir": ["quizzes", "src"] },
  "assets": { "directory": "public" },
  "vars": {
    // The quiz shown at "/". Any other quiz is reachable at /?quiz=<file name without .json>.
    "QUIZ": "sengoku",
    "JEV_MODEL": "jev-latest",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mulmo-kentei",
      // Placeholder, used as is for local development. The real id is CLOUDFLARE_D1_DATABASE_ID in .env
      // (written by `yarn setup:cloudflare`); `yarn deploy` puts it into wrangler.remote.jsonc.
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  // Secret (never in this file): TYPESAFE_API_KEY, uploaded from .env by `yarn setup:cloudflare`.
}
